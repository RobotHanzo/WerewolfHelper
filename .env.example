# Copy to .env and fill in. Used by docker-compose for variable substitution.
# All Discord values are optional: with no DISCORD_TOKEN the bot runs as a
# no-op gateway and the REST API + WebSocket dashboard still serve.

# Host port to expose the app on (container always listens on 8080).
PORT=8080

# Leave unset to use the bundled `mongo` service from docker-compose.
# Set to point at an external MongoDB instead, e.g.:
#   mongodb://user:pass@host:27017/WerewolfHelper?authSource=admin
# MONGODB_URI=

# --- Discord (optional) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Comma-separated Discord user IDs allowed to run `/server create`.
DISCORD_SERVER_CREATORS=
# Usually derived per-request from the origin; only a fallback.
DISCORD_REDIRECT_URI=

# --- Dashboard / CORS (optional) ---
# Fallback dashboard base URL when the request origin can't be resolved.
DASHBOARD_BASE_URL=
# Comma-separated allowed CORS origin patterns (defaults cover localhost/LAN/Tailscale).
CORS_ALLOWED_ORIGINS=

# Extra JVM flags for the app container, e.g. -Xmx512m
JAVA_OPTS=
